# Required to render the existing Sanity-backed site. Human supplies approved values.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Optional; the application default applies when omitted.
# NEXT_PUBLIC_SANITY_API_VERSION=

# Contact delivery stays disabled until separately authorized configuration and checks.
CONTACT_ENABLED=false
# Server-only values: never use NEXT_PUBLIC_ names or commit real credentials/addresses.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Required server-owned metadata flag, NOT a recipient or egress safety control.
CONTACT_TEST_MODE=false

# POST /api/contact now requires the strict lib/contact.ts submission contract.
# Only HTTP 202 with a valid accepted response means provider acceptance, not delivery.
# Deterministic tests use isolated reserved addresses and denied real egress.
# Live checks need separately authorized nonproduction credentials, sender and recipient.
# No Sanity writes, application inbox/outbox, or automatic email retries are introduced.
# Human operator disables sending with CONTACT_ENABLED=false; never restore fake success.
